# ============================================================================
# CONFIGURAÇÃO DO SISTEMA DE TRADING
# ============================================================================
#
# Copie este arquivo para .env e preencha com seus valores
#
# cp .env.example .env
#
# ============================================================================

# ----------------------------------------------------------------------------
# TELEGRAM (Opcional - para notificações)
# ----------------------------------------------------------------------------
# Para habilitar notificações via Telegram:
# 1. Crie um bot com @BotFather no Telegram
# 2. Copie o token fornecido
# 3. Inicie conversa com seu bot
# 4. Obtenha seu CHAT_ID via https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here

# ----------------------------------------------------------------------------
# FLASK (Servidor Web)
# ----------------------------------------------------------------------------
# Debug mode - NUNCA usar True em produção!
FLASK_DEBUG=False

# Host e porta do servidor
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
# Níveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# ENCERRANDO SISTEMA
# ----------------------------------------------------------------------------
# crie a senha para encerrar o sistema e gerar resumo geral dos resultados
CONTROL_TOKEN=password
# use a senha através do servidor web

# ----------------------------------------------------------------------------
# OBSERVAÇÕES
# ----------------------------------------------------------------------------
# 
# - Todas as outras configurações estão em config.py
# - Edite config.py para ajustar:
#   * Stop-loss e take-profit
#   * Limites de risco
#   * Thresholds de regime
#   * Parâmetros de estratégia
#
