# ============================================================================
# CONFIGURAÇÃO DO SISTEMA DE TRADING
# ============================================================================
#
# Copie este arquivo para .env e preencha com seus valores
#
# cp .env.example .env
#
# ============================================================================

# ----------------------------------------------------------------------------
# TELEGRAM (Opcional - para notificações)
# ----------------------------------------------------------------------------
# Para habilitar notificações via Telegram:
# 1. Crie um bot com @BotFather no Telegram
# 2. Copie o token fornecido
# 3. Inicie conversa com seu bot
# 4. Obtenha seu CHAT_ID via https://api.telegram.org/bot<TOKEN>/getUpdates
#
# Deixe vazio para desabilitar o Telegram.
TELEGRAM_TOKEN=
CHAT_ID=

# ----------------------------------------------------------------------------
# FLASK (Servidor Web)
# ----------------------------------------------------------------------------
# Debug mode - NUNCA usar True em produção!
FLASK_DEBUG=False

# Host e porta do servidor
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
# Níveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# EXECUÇÃO (Binance Spot via ccxt)
# ----------------------------------------------------------------------------
# PAPER   = simulação local (padrão, nenhuma ordem sai do computador)
# TESTNET = Binance Spot Testnet (sandbox, usa as chaves TESTNET abaixo)
# LIVE    = Binance Spot real (BLOQUEADO se ALLOW_LIVE_TRADING != True)
EXECUTION_MODE=PAPER

# Chaves da conta real (somente usadas se ALLOW_LIVE_TRADING=True)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Chaves da Binance Spot Testnet (https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Trava dupla de segurança: mesmo com EXECUTION_MODE=LIVE, o motor recusa
# iniciar se isto não estiver explicitamente True.
ALLOW_LIVE_TRADING=False

# ----------------------------------------------------------------------------
# ENCERRANDO SISTEMA
# ----------------------------------------------------------------------------
# Token para encerrar o sistema e gerar resumo geral dos resultados.
# Use uma senha forte. Deixe vazio para desabilitar os botões de controle.
CONTROL_TOKEN=
# use a senha através do servidor web

# ----------------------------------------------------------------------------
# OBSERVAÇÕES
# ----------------------------------------------------------------------------
#
# - Todas as outras configurações estão em config.py
# - Edite config.py para ajustar:
#   * Stop-loss e take-profit
#   * Limites de risco
#   * Thresholds de regime
#   * Parâmetros de estratégia
